# 软著配置文件
# 定义要申请的软著及其代码范围

snapshot:
  repository: my-project
  created_at: "2026-07-22"

policies:
  path_overlap: forbidden
  exact_content_overlap: forbidden
  copied_code_detection: enabled
  unallocated_file_access: forbidden
  shared_file_policy: excluded
  generated_code_policy: excluded
  third_party_code_policy: excluded

# 团队成员（用于 Feature 2: 代码归属分析）
# 基于 git blame 邮箱地址判别，只有团队成员新增/修改的代码才纳入软著申请
# 如果项目基于开源项目开发，此配置确保只对团队原创代码申请软著
team:
  - name: 张三
    email: zhangsan@company.com
    role: lead
  - name: 李四
    email: lisi@company.com
    role: developer
  - name: 王五
    email: wangwu@company.com
    role: developer

copyrights:
  # description 会直接作为《软件的主要功能》，去除空白后必须为500至1300字。
  # 必须按真实系统填写；不能使用通用模板、重复段落或占位内容凑字数。
  - id: service-a
    name: XX服务系统
    version: V1.0
    description: ""
    description_status: required_manual_input_500_to_1300_characters
    include_paths:
      - services/a/**
      - libs/a-core/**
    exclude_paths:
      - services/b/**
      - services/c/**
      - shared/**
      - vendor/**
      - generated/**
      - tests/**

  - id: service-b
    name: YY处理系统
    version: V1.0
    description: ""
    description_status: required_manual_input_500_to_1300_characters
    include_paths:
      - services/b/**
      - libs/b-core/**
    exclude_paths:
      - services/a/**
      - services/c/**
      - shared/**
      - vendor/**
      - generated/**
      - tests/**
